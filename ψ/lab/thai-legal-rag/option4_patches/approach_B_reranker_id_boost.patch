+# Approach B (ID-query rerank boost): when the query names a หนังสือเวียน by its
+# circular number ("ว 397"), strongly boost pooled chunks of that exact circular so
+# it ranks #1. The chunk is already in the pool (BM25 nails it) but fusion with
+# hundreds of vector hits dilutes it; this boost overcomes the dilution while
+# keeping the hybrid pool intact (unlike Approach A which drops to BM25-only).
+_ID_QUERY_RE = re.compile(r"(?:^|\s)ว\s*([\d๐-๙]{1,4})\b")
+_THAI_DIGITS = "๐๑๒๓๔๕๖๗๘๙"
+ID_MATCH_BOOST = 5.0
+
+
+def _to_thai_digits(s: str) -> str:
+    return "".join(_THAI_DIGITS[int(c)] if c.isdigit() else c for c in s)
+
+
+def _id_query_markers(query: str) -> list[str]:
+    """If query names a circular ('ว 397'), return source_name/ref_number substrings
+    that identify that exact circular (both Arabic and Thai numeral forms)."""
+    m = _ID_QUERY_RE.search(query)
+    if not m:
+        return []
+    # Normalise the matched digits to Arabic, then derive the Thai-numeral form.
+    arabic = "".join(str(_THAI_DIGITS.index(c)) if c in _THAI_DIGITS else c for c in m.group(1))
+    thai = _to_thai_digits(arabic)
+    return [f"ว{arabic}", f"ว_{arabic}", f"ว {arabic}", f"ว {thai}", f"ว{thai}"]
+
 _SOURCE_WEIGHTS = {
